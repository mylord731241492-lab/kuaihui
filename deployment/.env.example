# Copy to .env; do not commit .env or real credentials.
JUHE_DOMAIN=service.example.com
JUHE_TLS_EMAIL=owner@example.com
JUHE_PROXY_SECRET=
# Public services cannot use legacy admin bearer keys or fake SMS.
JUHE_ALLOW_LEGACY_ADMIN_KEY=false
# Select spug or aliyun; incomplete credentials leave SMS disabled.
JUHE_SMS_PROVIDER=spug
# Secret code for the fixed ten-minute Spug template (code variable only, server only).
JUHE_SPUG_TEMPLATE_CODE=
# Optional legacy Aliyun adapter; used only when explicitly selected.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
JUHE_SMS_SIGN_NAME=
JUHE_SMS_TEMPLATE_CODE=
JUHE_SMS_DAILY_LIMIT=100
# Optional HTTPS endpoint under your control; JSON event notification, not a vendor chat webhook format.
JUHE_ALERT_WEBHOOK=
