# Initialized by: bash ip-deploy.sh init PUBLIC_IPV4 EMAIL
JUHE_PUBLIC_IP=
JUHE_TLS_EMAIL=
JUHE_PROXY_SECRET=
JUHE_ALLOW_LEGACY_ADMIN_KEY=false
# Optional image overrides; Certbot must be >= 5.4 for IP webroot.
JUHE_CERTBOT_IMAGE=certbot/certbot:v5.8.0
# Select spug or aliyun; incomplete credentials leave SMS disabled.
JUHE_SMS_PROVIDER=spug
# Secret code for the fixed ten-minute Spug template (code variable only).
# Never put this code in the client or paste the send URL into a browser.
JUHE_SPUG_TEMPLATE_CODE=
# Optional legacy Aliyun adapter; used only when explicitly selected.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
JUHE_SMS_SIGN_NAME=
JUHE_SMS_TEMPLATE_CODE=
JUHE_SMS_DAILY_LIMIT=100
JUHE_ALERT_WEBHOOK=
